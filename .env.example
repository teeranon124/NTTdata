# ==========================================
# AutoProcure.AI - Environment Configuration
# ==========================================

# Flask Server Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=8080
FLASK_DEBUG=1
SECRET_KEY=autoprocure_secret_key_nttdata_2026

# AWS Bedrock & SES Credentials (Optional for local simulation, required for live AWS)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
BEDROCK_ROUTER_MODEL=amazon.nova-lite-v1:0
BEDROCK_NEGOTIATOR_MODEL=amazon.nova-pro-v1:0
SES_SENDER_EMAIL=procurement-agent@autoprocure.nttdata.co.th

# SAP S/4HANA Connection (RFC / OData / BTP Destination)
SAP_BASE_URL=https://my-sap-s4hana.corp.internal:44300
SAP_CLIENT=100
SAP_USER=RFC_AUTOPROCURE
SAP_PASSWORD=your_sap_password
SAP_BAPI_ENABLED=false
