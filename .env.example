# ==========================================
# AutoProcure.AI - Environment Configuration
# Copy this file to `.env` and fill in real values to enable Live AWS.
# ==========================================

# Flask Server Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=8080
FLASK_DEBUG=1
SECRET_KEY=autoprocure_secret_key_nttdata_2026

# ------------------------------------------
# AWS Bedrock (LLM) Credentials
# ------------------------------------------
# Leave blank to run in deterministic Local Fallback mode (demo never crashes).
# Fill both keys to switch to Live Amazon Bedrock automatically.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Region must host both Claude 3.5 Sonnet and Nova Lite (us-east-1 recommended).
# Both AWS_REGION and AWS_DEFAULT_REGION are accepted.
AWS_DEFAULT_REGION=us-east-1

# Negotiator = Claude 3.5 Sonnet (professional Thai procurement voice).
# Router = Nova Lite (fast, cheap intent extraction).
# NOTE: In some regions Claude 3.5 Sonnet requires a cross-region inference profile.
#   If you see "on-demand throughput isn't supported", switch to:
#   BEDROCK_NEGOTIATOR_MODEL_ID=us.anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_NEGOTIATOR_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_ROUTER_MODEL_ID=amazon.nova-lite-v1:0

# ------------------------------------------
# AWS SES (Supplier invite emails / Magic Link)
# ------------------------------------------
# SES_ENABLED=false  -> simulated send (logged only, never fails) — safe for demo.
# SES_ENABLED=true   -> real boto3 ses.send_email(). In SES sandbox you MUST first
#                       verify both the sender AND every recipient email address.
SES_ENABLED=false
SES_SENDER_EMAIL=procurement-agent@autoprocure.nttdata.co.th

# ------------------------------------------
# SAP S/4HANA Connection (RFC / OData / BTP Destination)
# ------------------------------------------
SAP_BASE_URL=https://my-sap-s4hana.corp.internal:44300
SAP_CLIENT=100
SAP_USER=RFC_AUTOPROCURE
SAP_PASSWORD=your_sap_password
SAP_BAPI_ENABLED=false
