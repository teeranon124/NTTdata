# ==========================================
# AutoProcure.AI - Environment Configuration
# Copy this file to `.env` and fill in real values to enable Live AWS.
# ==========================================

# Flask Server Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=8080
FLASK_DEBUG=1
SECRET_KEY=autoprocure_secret_key_nttdata_2026

# ------------------------------------------
# AWS Bedrock (LLM) Credentials
# ------------------------------------------
# Leave blank to run in deterministic Local Fallback mode (demo never crashes).
# Fill both keys to switch to Live Amazon Bedrock automatically.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Region must host both Claude 3.5 Sonnet and Nova Micro (us-east-1 recommended).
# Both AWS_REGION and AWS_DEFAULT_REGION are accepted.
AWS_DEFAULT_REGION=us-east-1

# Negotiator = Claude 3.5 Sonnet (professional Thai procurement voice).
# Router = Nova Micro (fast, cheap intent extraction).
# NOTE: In some regions Claude 3.5 Sonnet requires a cross-region inference profile.
#   If you see "on-demand throughput isn't supported", switch to:
#   BEDROCK_NEGOTIATOR_MODEL_ID=us.anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_NEGOTIATOR_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_ROUTER_MODEL_ID=amazon.nova-micro-v1:0

# Dynamic Model Gateway tiers (optional overrides). If unset, the gateway uses
# the router model for LIGHT tasks and the negotiator model for HEAVY tasks.
#   FAST   (LIGHT: intent parse/classify/validate) -> Nova Micro / Claude 3.5 Haiku
#   STRONG (HEAVY: strategic negotiation/synthesis) -> Claude 3.5 Sonnet / Nova Pro
BEDROCK_FAST_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_STRONG_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Optional Amazon Bedrock Guardrails (managed content policy).
# When BEDROCK_GUARDRAIL_ID is set AND AWS is reachable, guardrails apply in TWO ways:
#   1) Standalone  : ComplianceGuardrailAgent screens supplier input via the
#                    ApplyGuardrail API (PROMPT_ATTACK content filter, denied
#                    topics, word/PII filters) before any model call.
#   2) Inline      : bedrock_client attaches guardrailConfig to the Converse call,
#                    so both model input and output are filtered during inference.
# Leave BEDROCK_GUARDRAIL_ID blank to rely on the deterministic local guardrails
# (input sanitization + injection regex + hard procurement boundaries) — the demo
# stays fully protected even with no AWS guardrail provisioned.
# Create a guardrail in the Bedrock console, then set its ID + version here.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ------------------------------------------
# AWS SES (Supplier invite emails / Magic Link)
# ------------------------------------------
# SES_ENABLED=false  -> simulated send (logged only, never fails) — safe for demo.
# SES_ENABLED=true   -> real boto3 ses.send_email(). In SES sandbox you MUST first
#                       verify both the sender AND every recipient email address.
SES_ENABLED=false
SES_SENDER_EMAIL=procurement-agent@autoprocure.nttdata.co.th

# ------------------------------------------
# Database (Enterprise ORM layer)
# ------------------------------------------
# USE_DATABASE=false -> legacy JSON-file storage (default, zero-config).
# USE_DATABASE=true  -> SQLAlchemy ORM. Tables are auto-created and seeded
#                       (60 deals + 2,500 PRs) on first startup.
USE_DATABASE=false
# DATABASE_URL unset -> SQLite file at webapp/data/autoprocure.db (zero-config).
# For AWS RDS PostgreSQL, set e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:pass@your-rds-host:5432/autoprocure
DATABASE_URL=

# ------------------------------------------
# Real-time SSE fan-out (multi-worker / multi-instance)
# ------------------------------------------
# Unset -> in-memory SSE (correct for a single Gunicorn worker / single instance).
# Set to a Redis URL when running >1 worker or >1 instance so live events reach
# every connected dashboard regardless of which worker produced them.
#   REDIS_URL=redis://your-redis-host:6379/0
REDIS_URL=

# ------------------------------------------
# Admin / demo data hygiene
# ------------------------------------------
# Enables POST /api/admin/reset-sessions to wipe transient negotiation sessions
# (keeping the 60-deal / 2,500-PR seed catalog) for a clean slate before a demo.
# Leave BLANK to DISABLE the endpoint entirely (safe default for production).
ADMIN_RESET_TOKEN=

# ------------------------------------------
# SAP S/4HANA Connection (RFC / OData / BTP Destination)
# ------------------------------------------
SAP_BASE_URL=https://my-sap-s4hana.corp.internal:44300
SAP_CLIENT=100
SAP_USER=RFC_AUTOPROCURE
SAP_PASSWORD=your_sap_password
SAP_BAPI_ENABLED=false
